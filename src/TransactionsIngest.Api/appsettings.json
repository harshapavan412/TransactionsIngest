{
  "ConnectionStrings": {
    "TransactionsDb": "Data Source=transactions.db"
  },
  "Import": {
    "RevocationWindowHours": 24,
    "FinalizationEnabled": true
  },

    "Sources": {
    "DataDirectory": "sample-data",
    "Systems": [
      { "Name": "Store Uptown", "FileName": "store-uptown.json" },
      { "Name": "Store Downtown", "FileName": "store-downtown.json" },
      { "Name": "Online", "FileName": "online.json" }
    ]
  },
  
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}